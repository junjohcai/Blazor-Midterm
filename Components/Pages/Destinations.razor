@page "/destinations"
@using MyBlazorApp.Components.Shared
@using MyBlazorApp.Models
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Roamwild - All Destinations</PageTitle>

<main class="min-h-screen bg-sand text-forest selection:bg-coral selection:text-white pb-24 relative">
    <!-- Solid Header -->
    <header class="bg-forest text-white py-6 px-5 md:px-10 lg:px-16">
        <div class="mx-auto flex max-w-[1440px] items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="/#experiences" class="grid h-10 w-10 place-items-center rounded-full border border-white/35 transition-transform hover:scale-105" aria-label="Back to home">
                    <span class="rotate-180"><AppIcon Name="arrow" Size="18" /></span>
                </a>
                <a href="/" class="logo group flex items-center gap-2.5 text-left">
                    <span class="grid h-10 w-10 place-items-center rounded-full border border-white/45 transition-transform group-hover:rotate-12">
                        <AppIcon Name="compass" Size="22" />
                    </span>
                    <span class="font-display text-[1.55rem] tracking-tight">Roamwild</span>
                </a>
            </div>

            <nav class="hidden items-center gap-9 text-sm font-medium lg:flex">
                <a class="nav-link text-coral" href="/destinations">Destinations</a>
                <a class="nav-link hover:text-coral transition-colors" href="/journal">Journal</a>
                <a class="nav-link hover:text-coral transition-colors" href="/experts">Experts</a>
                <a class="nav-link hover:text-coral transition-colors" href="/contact">Contact</a>
            </nav>

            <a href="/contact" class="hidden h-11 items-center gap-2 rounded-full border border-white/40 px-5 text-sm font-semibold transition-colors hover:bg-white hover:text-forest sm:flex">
                Plan my trip <AppIcon Name="arrow" Size="17" />
            </a>
        </div>
    </header>

    <section class="mx-auto max-w-[1440px] px-5 py-20 md:px-10 lg:px-16">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-coral">Explore the Globe</p>
        <h1 class="font-display text-5xl md:text-7xl leading-tight mt-4">All <em>Destinations.</em></h1>
        
        <!-- Filter Bar -->
        <div class="mt-12 flex flex-wrap items-center gap-4 border-b border-forest/10 pb-6">
            <span class="text-xs font-bold uppercase tracking-widest text-forest/50 mr-4">Filter by:</span>
            
            <button @onclick='() => SetFilter("All")' class="px-5 py-2 rounded-full text-sm font-semibold transition-colors @(activeFilter == "All" ? "bg-forest text-white" : "bg-white/50 text-forest hover:bg-white")">
                All
            </button>
            <button @onclick='() => SetFilter("Asia")' class="px-5 py-2 rounded-full text-sm font-semibold transition-colors @(activeFilter == "Asia" ? "bg-forest text-white" : "bg-white/50 text-forest hover:bg-white")">
                Asia
            </button>
            <button @onclick='() => SetFilter("Europe")' class="px-5 py-2 rounded-full text-sm font-semibold transition-colors @(activeFilter == "Europe" ? "bg-forest text-white" : "bg-white/50 text-forest hover:bg-white")">
                Europe
            </button>
            <button @onclick='() => SetFilter("Africa")' class="px-5 py-2 rounded-full text-sm font-semibold transition-colors @(activeFilter == "Africa" ? "bg-forest text-white" : "bg-white/50 text-forest hover:bg-white")">
                Africa
            </button>
            <button @onclick='() => SetFilter("South America")' class="px-5 py-2 rounded-full text-sm font-semibold transition-colors @(activeFilter == "South America" ? "bg-forest text-white" : "bg-white/50 text-forest hover:bg-white")">
                South America
            </button>
        </div>

        <!-- Filtered Grid -->
        <div class="mt-10 grid gap-7 md:grid-cols-3">
            @if (filteredDestinations.Any())
            {
                @foreach (var dest in filteredDestinations)
                {
                    <article @onclick="() => OpenModal(dest)" class="journey-card group cursor-pointer">
                        <div class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem]">
                            <img class="h-full w-full object-cover transition duration-700 group-hover:scale-105" src="@dest.Image" alt="@dest.Alt" />
                            <div class="absolute inset-0 bg-gradient-to-t from-forest/80 via-transparent to-transparent"></div>
                            <span class="absolute left-5 top-5 rounded-full bg-white/90 px-4 py-2 text-xs font-bold uppercase tracking-wider text-forest backdrop-blur">
                                @dest.Badge
                            </span>
                            <div class="absolute bottom-0 left-0 p-6 text-white">
                                <p class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-white/75"><AppIcon Name="location" Size="15" /> @dest.Location</p>
                                <h3 class="font-display text-3xl leading-tight">@dest.Title</h3>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    </section>

    <!-- Popup Inquiry Modal -->
    @if (selectedDestination != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4 animate-fadeIn">
            <div class="w-full max-w-lg rounded-[2rem] bg-cream p-8 md:p-10 text-forest shadow-2xl border border-forest/10">
                
                <!-- Header row with title label and close button side-by-side -->
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-coral">Inquire about journey</span>
                        <h3 class="font-display text-3xl leading-tight mt-1">@selectedDestination.Title</h3>
                        <p class="text-xs font-bold uppercase tracking-widest text-forest/50 mt-1">@selectedDestination.Location · @selectedDestination.Badge</p>
                    </div>
                    <button @onclick="CloseModal" class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-forest/5 text-forest transition-colors hover:bg-forest hover:text-white" aria-label="Close modal">
                        <AppIcon Name="x" Size="18" />
                    </button>
                </div>

                @if (isSubmitted)
                {
                    <div class="text-center py-8">
                        <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-coral/20 text-coral mb-4">
                            <AppIcon Name="heart" Size="28" />
                        </span>
                        <h3 class="font-display text-3xl mb-2">You're on the list!</h3>
                        <p class="text-forest/70 text-sm leading-6">We've sent the complete itinerary and pricing details for <strong>@selectedDestination.Title</strong> to <em>@userEmail</em>.</p>
                        <button @onclick="CloseModal" class="mt-8 rounded-full bg-forest px-8 py-3 text-sm font-semibold text-white transition-transform hover:scale-105">Back to destinations</button>
                    </div>
                }
                else
                {
                    <div class="mt-6">
                        <p class="text-sm text-forest/70 leading-relaxed">Enter your email address and our local guides will send you the custom route details, available dates, and booking process.</p>

                        <form @onsubmit="SubmitInquiry" class="mt-6 space-y-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-widest text-forest/70 mb-2">Email address</label>
                                <input required @bind="userEmail" type="email" class="w-full bg-white border border-forest/10 rounded-xl px-5 py-4 outline-none focus:border-coral transition-colors text-sm" placeholder="jane@example.com" />
                            </div>
                            <button type="submit" class="w-full flex items-center justify-center gap-2 rounded-xl bg-coral px-8 py-4 font-semibold text-white transition-all hover:bg-coral-dark text-sm">
                                Request Details <AppIcon Name="arrow" Size="18" />
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</main>

@code {
    private string activeFilter = "All";
    private DestinationItem? selectedDestination = null;
    private string userEmail = "";
    private bool isSubmitted = false;

    private record DestinationItem(string Title, string Location, string Continent, string Badge, string Image, string Alt);

    private List<DestinationItem> allDestinations = new()
    {
        // ASIA
        new("Lagoons beyond the map", "Coron, Philippines", "Asia", "7 Days", "https://images.unsplash.com/photo-1570789210967-2cac24afeb00", "Coron, Philippines"),
        new("Slow days under palms", "Siargao, Philippines", "Asia", "8 Days", "https://images.unsplash.com/photo-1512343879784-a960bf40e7f2", "Siargao, Philippines"),
        new("Barefoot in the blue", "Baa Atoll, Maldives", "Asia", "6 Days", "https://images.unsplash.com/photo-1514282401047-d79a71a590e8", "Maldives"),
        new("Kyoto in full bloom", "Kyoto, Japan", "Asia", "9 Days", "https://dynamic-media.tacdn.com/media/photo-o/34/1d/af/f2/caption.jpg?f=webp&w=2400&h=1400", "Kyoto, Japan"),
        new("Bamboo Forest Trails", "Arashiyama, Japan", "Asia", "5 Days", "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e", "Arashiyama Bamboo Grove"),
        new("Temple & Tea Retreat", "Uji, Japan", "Asia", "4 Days", "https://images.unsplash.com/photo-1503899036084-c55cdd92da26", "Uji Japan"),
        new("Ubud Jungle Sanctuary", "Ubud, Bali", "Asia", "6 Days", "https://images.unsplash.com/photo-1537996194471-e657df975ab4", "Bali Indonesia"),

        // EUROPE
        new("High peaks & quiet lakes", "Bernese Alps, Switzerland", "Europe", "7 Days", "https://images.unsplash.com/photo-1531366936337-7c912a4589a7", "Swiss Alps"),
        new("Matterhorn Base Camp", "Zermatt, Switzerland", "Europe", "6 Days", "https://images.unsplash.com/photo-1502145882672-972c7221da43", "Zermatt Matterhorn"),
        new("Glacier Express Route", "St. Moritz, Switzerland", "Europe", "5 Days", "https://images.unsplash.com/photo-1527668743097-a62371d79867", "St Moritz"),
        new("Path of the Gods", "Amalfi Coast, Italy", "Europe", "6 Days", "https://images.unsplash.com/photo-1516483638261-f40889d04f6d", "Amalfi Coast"),
        new("Caldera Sail & Sunsets", "Santorini, Greece", "Europe", "5 Days", "https://images.unsplash.com/photo-1570077188670-e3a8d69ac5f1", "Santorini Greece"),

        // AFRICA
        new("Follow the old caravan road", "Sahara, Morocco", "Africa", "8 Days", "https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9", "Sahara Desert"),
        new("Atlas Mountain Kasbahs", "Marrakech, Morocco", "Africa", "5 Days", "https://images.unsplash.com/photo-1539650116574-8efeb43e2750", "Morocco"),
        new("Wild encounters & golden light", "Maasai Mara, Kenya", "Africa", "6 Days", "https://images.unsplash.com/photo-1516426122078-c23e76319801", "Maasai Mara"),
        new("Rift Valley Safari", "Lake Nakuru, Kenya", "Africa", "4 Days", "https://images.unsplash.com/photo-1534567153574-2b12153a87f0", "Kenya Safari"),

        // SOUTH AMERICA
        new("Untamed peaks & glaciers", "Patagonia, Chile", "South America", "7 Days", "https://images.unsplash.com/photo-1518182170546-0766de6b6aad", "Patagonia Chile"),
        new("The W Trek Explorer", "Torres del Paine", "South America", "8 Days", "https://images.unsplash.com/photo-1517411648083-4a1b0be0dce0", "Torres del Paine")
    };

    private List<DestinationItem> filteredDestinations => activeFilter == "All" 
        ? allDestinations 
        : allDestinations.Where(d => d.Continent == activeFilter).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
    }

    private void OpenModal(DestinationItem item)
    {
        selectedDestination = item;
        userEmail = "";
        isSubmitted = false;
    }

    private void CloseModal()
    {
        selectedDestination = null;
    }

    private void SubmitInquiry()
    {
        isSubmitted = true;
    }
}