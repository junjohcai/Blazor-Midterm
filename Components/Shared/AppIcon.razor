@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" @attributes="AdditionalAttributes">
    @switch (Name)
    {
        case "arrow": <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />; break;
        case "calendar": <path d="M8 2v4M16 2v4M3 10h18" /><rect x="3" y="5" width="18" height="16" rx="2" />; break;
        case "chevron": <path d="m9 18 6-6-6-6" />; break;
        case "compass": <circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" />; break;
        case "heart": <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />; break;
        case "location": <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" />; break;
        case "menu": <path d="M4 7h16M4 12h16M4 17h16" />; break;
        case "play": <path d="m9 7 8 5-8 5V7Z" />; break;
        case "search": <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />; break;
        case "users": <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8" />; break;
        case "x": <path d="M6 6l12 12M18 6 6 18" />; break;
    }
</svg>